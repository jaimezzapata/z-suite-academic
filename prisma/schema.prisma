// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String           @id @default(cuid())
  name          String?
  email         String?          @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  credential    UserCredential?
  institutions  Institution[]
  locations     Location[]
  coreContents  CoreContent[]
  studyPlans    StudyPlan[]
  cohorts       Cohort[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model Account {
  id                    String  @id @default(cuid())
  userId                String
  type                  String
  provider              String
  providerAccountId     String
  refresh_token         String?
  refreshTokenEncrypted String?
  access_token          String?
  expires_at            Int?
  token_type            String?
  scope                 String?
  id_token              String?
  session_state         String?
  user                  User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserCredential {
  id           String   @id @default(cuid())
  userId       String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Institution {
  id             String      @id @default(cuid())
  userId         String
  name           String
  minutesPerHour Int
  paymentType    PaymentType
  periodType     PeriodType
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  locations      Location[]
  cohorts        Cohort[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([userId, name])
}

model Location {
  id            String       @id @default(cuid())
  userId        String
  institutionId String
  name          String
  code          String?
  address       String?
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  studyPlans    StudyPlan[]
  cohorts       Cohort[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([institutionId, name])
}

model CoreContent {
  id         String      @id @default(cuid())
  userId     String
  name       String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyPlans StudyPlan[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([userId, name])
}

model StudyPlan {
  id            String                 @id @default(cuid())
  userId        String
  locationId    String
  coreContentId String
  aliasName     String
  sourceSlug    String?
  sourceType    StudyPlanSourceType    @default(MANUAL)
  structureType StudyPlanStructureType @default(CUSTOM)
  metadata      Json?
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  location      Location               @relation(fields: [locationId], references: [id], onDelete: Cascade)
  coreContent   CoreContent            @relation(fields: [coreContentId], references: [id], onDelete: Cascade)
  cohorts       Cohort[]
  periods       StudyPlanPeriod[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@unique([locationId, aliasName])
  @@unique([userId, sourceSlug])
}

model StudyPlanPeriod {
  id          String           @id @default(cuid())
  studyPlanId String
  name        String
  order       Int
  metadata    Json?
  studyPlan   StudyPlan        @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)
  items       StudyPlanItem[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([studyPlanId, order])
}

model StudyPlanItem {
  id                String            @id @default(cuid())
  studyPlanPeriodId String
  title             String
  itemType          StudyPlanItemType @default(SUBJECT)
  code              String?
  description       String?
  order             Int
  metadata          Json?
  outcomes          Json?
  studyPlanPeriod   StudyPlanPeriod   @relation(fields: [studyPlanPeriodId], references: [id], onDelete: Cascade)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([studyPlanPeriodId, order])
}

model Cohort {
  id            String       @id @default(cuid())
  userId        String
  institutionId String
  locationId    String?
  studyPlanId   String?
  name          String
  code          String?
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  location      Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  studyPlan     StudyPlan?   @relation(fields: [studyPlanId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([userId, name])
}

enum PaymentType {
  HOURLY
  FIXED_SALARY
}

enum PeriodType {
  SEMESTER
  TRIMESTER
}

enum StudyPlanSourceType {
  MANUAL
  PRESET
  JSON
  XLSX
  MARKDOWN
}

enum StudyPlanStructureType {
  LEVELS
  TRIMESTERS
  CUSTOM
}

enum StudyPlanItemType {
  SUBJECT
  MODULE
  OUTCOME_GROUP
  MILESTONE
  OTHER
}
